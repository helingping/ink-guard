{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "lib": ["ES2019", "DOM"],
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "engine/types/**/*.d.ts"]
}
